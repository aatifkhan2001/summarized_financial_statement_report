	column Quarter_Tag = ```
			
			VAR MonthNum = MONTH('BS (Quaterwise)'[Quarters])
			VAR YearNum = YEAR('BS (Quaterwise)'[Quarters])
			VAR QuarterNum =
			    SWITCH(
			        TRUE(),
			        MonthNum IN {1,2,3}, 1,
			        MonthNum IN {4,5,6}, 2,
			        MonthNum IN {7,8,9}, 3,
			        MonthNum IN {10,11,12}, 4
			    )
			RETURN
			"Q" & QuarterNum & " " & YearNum
			
			```
		lineageTag: dc945145-09b2-4b19-bc6d-67f00e952209
		summarizeBy: none
		sortByColumn: bs_quarter_sort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column bs_quarter_sort = ```
			
			YEAR('BS (Quaterwise)'[Quarters] * 10 + 
			SWITCH(
			    TRUE(),
			    MONTH('BS (Quaterwise)'[Quarters]) IN {1,2,3}, 1,
			    MONTH('BS (Quaterwise)'[Quarters]) IN {4,5,6}, 2,
			    MONTH('BS (Quaterwise)'[Quarters]) IN {7,8,9}, 3,
			    MONTH('BS (Quaterwise)'[Quarters]) IN {10,11,12}, 4
			))
			
			```
		formatString: 0
		lineageTag: e430d7e9-0dbe-475b-af2e-74800ae4dc12
