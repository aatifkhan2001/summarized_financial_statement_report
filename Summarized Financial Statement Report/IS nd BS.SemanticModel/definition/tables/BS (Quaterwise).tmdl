table 'BS (Quaterwise)'
	lineageTag: 55e88113-5f99-47e4-8cbf-2433c208c3a2

	measure t_assets = SUM('BS (Quaterwise)'[Total assets])
		formatString: 0
		lineageTag: 7eade582-6276-4313-91ec-314f83cd87c3

	measure t_liabilities = SUM('BS (Quaterwise)'[Total liabilities])
		formatString: 0
		lineageTag: 7bbb682e-c895-4faf-bd9d-b5c8d10af66f

	measure 'Debt-To-Equity Ratio' = SUM('BS (Quaterwise)'[Total liabilities]) / SUM('BS (Quaterwise)'[Total Equity])
		lineageTag: d03a50d2-0c13-49af-9945-9d85b2a4705b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure t_equity = SUM('BS (Quaterwise)'[Total Equity])
		formatString: 0
		lineageTag: d6ae16fa-f618-42ac-ae0d-d6f976bc6b36

	measure n_assets = [t_assets] - [t_liabilities]
		formatString: 0
		lineageTag: 8673b54b-d54c-4ca8-af47-e1b8aeb2b5eb

	measure 'Equity Ratio' = [t_equity] / [t_assets]
		lineageTag: 4b1d11ec-2e32-4e01-90e4-62cd86574a3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure gauge_min_val = 0
		formatString: 0
		lineageTag: 5b9c3a5b-b9dd-43ed-824e-05fa22044c14

	measure gauge_target_val = 0.5
		lineageTag: e76f8160-d3b9-4924-a72f-715f53e79084

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure gauge_max_val = 1.0
		lineageTag: 36355412-de0d-413f-a913-486426a2e63e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure total_liabilities = SUM('BS (Quaterwise)'[Total liabilities])
		formatString: 0
		lineageTag: 71a1bd13-3c91-4d6f-9aad-7b639ed1c5aa

	measure total_assets = SUM('BS (Quaterwise)'[Total assets])
		formatString: 0
		lineageTag: 4f60fb88-d80e-408b-9948-b784bfa256dc

	measure 'Debt to Equity Color' = ```
			
			VAR _DE = [Debt-To-Equity Ratio]
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(_DE), BLANK(),
			    _DE < 0.50, "#F9A825",   
			    _DE <= 1.50, "#2E7D32",  
			    _DE <= 2.50, "#EF6C00",  
			    "#C62828"                
			)
			
			```
		lineageTag: 5562f052-9560-4d1c-a3ed-bdb0115037d5

