table DateTb
	lineageTag: d8602773-889f-4b30-98e9-ad059607b466
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 98fc587e-3951-4c0b-a89d-e2ff7825cecd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 1a3c5b25-3988-45f1-8ebc-95c0288a9783
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

