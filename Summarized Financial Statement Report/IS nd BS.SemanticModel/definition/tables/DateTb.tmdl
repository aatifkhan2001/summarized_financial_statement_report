	column Quarter
		lineageTag: 4a4ab85c-e74a-4aab-b34b-ffc495d3a6bc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	partition DateTb = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2022,1,1), DATE(2025,12,31)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & FORMAT(QUARTER([Date]), "0") & "-" & YEAR([Date])
				)
				
				```

	annotation PBI_Id = b0f7ad35ef8a4d46b9e90eec5a0706bf

