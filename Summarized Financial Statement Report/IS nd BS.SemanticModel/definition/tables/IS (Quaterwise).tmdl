	column 'Quarter Label' = ```
			
			VAR MonthNum = MONTH('IS (Quaterwise)'[Quarters])
			VAR YearNum = YEAR('IS (Quaterwise)'[Quarters])
			VAR QuarterNum =
			    SWITCH(
			        TRUE(),
			        MonthNum IN {1,2,3}, 1,
			        MonthNum IN {4,5,6}, 2,
			        MonthNum IN {7,8,9}, 3,
			        MonthNum IN {10,11,12}, 4
			    )
			RETURN
			"Q" & QuarterNum & " " & YearNum
			
			```
		lineageTag: 0db6dfeb-5126-42ab-a8db-be073225c69f
		summarizeBy: none
		sortByColumn: 'dropdown sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'dropdown sort' = ```
			
			YEAR('IS (Quaterwise)'[Quarters]) * 10 + 
			SWITCH(
			    TRUE(),
			    MONTH('IS (Quaterwise)'[Quarters]) IN {1,2,3}, 1,
			    MONTH('IS (Quaterwise)'[Quarters]) IN {4,5,6}, 2,
			    MONTH('IS (Quaterwise)'[Quarters]) IN {7,8,9}, 3,
			    MONTH('IS (Quaterwise)'[Quarters]) IN {10,11,12}, 4
			)
			
			```
		formatString: 0
		lineageTag: 51e77dfd-2f1c-4b3c-afb1-c31b0fa436d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

