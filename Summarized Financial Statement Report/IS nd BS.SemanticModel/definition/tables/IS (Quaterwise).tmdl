table 'IS (Quaterwise)'
	lineageTag: 177f7d72-9ed2-4c68-9f86-28f855fa44e9

	measure abs_nonrecurrval = ```
			
			SUMX(
			    'IS (Quaterwise)',
			    IF('IS (Quaterwise)'[Non-Recurring Revenue] < 0, ABS('IS (Quaterwise)'[Non-Recurring Revenue]), 'IS (Quaterwise)'[Non-Recurring Revenue])
			)
			
			```
		formatString: 0
		lineageTag: ef0ce9e7-5471-4ea1-870e-e17cf9c7bbc0

	measure 'total revenue' = CALCULATE(SUM('IS (Quaterwise)'[Total income]))
		formatString: 0
		lineageTag: 4a7122ad-1259-4a92-a70b-e287afa8e255

	measure t_expenses = CALCULATE(SUM('IS (Quaterwise)'[Total expenses]))
		formatString: 0
		lineageTag: f32c36b0-a422-4c98-8fcd-98217705dc5e

	measure net_profit = SUM('IS (Quaterwise)'[Net profit])
		formatString: 0
		lineageTag: 0f89991c-d884-48d6-b4ee-e02a4a389c84

	measure 'coverage ratio' = SUM('IS (Quaterwise)'[Administrative expenses]) / SUM('IS (Quaterwise)'[Recurring Revenue])
		lineageTag: 5a33f696-aa68-43a8-b15f-edfbc08cfba4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Coverage Ratio Color' = ```
			
			IF(
			    [Coverage Ratio] > 0.5,   
			    "Red",
			    "Green"                   
			)
			
			```
		lineageTag: 22b2b127-cad1-4d3a-a000-848ee0eff0ec

	measure cost_to_income_ratio = SUM('IS (Quaterwise)'[Total expenses]) / SUM('IS (Quaterwise)'[Total income])
		lineageTag: 073472e3-d302-4158-adb1-52cfa75d5ba5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure operating_expense_ratio = SUM('IS (Quaterwise)'[Administrative expenses])/ SUM('IS (Quaterwise)'[Total income])
		lineageTag: c8c1b7e2-1654-4fdc-bf22-a2b9c1943087

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OER Color' = ```
			
			VAR _OER = [operating_expense_ratio]
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(_OER), BLANK(),
			    _OER <= 0.30, "#2E7D32",   
			    _OER <= 0.45, "#F9A825",   
			    _OER <= 0.60, "#EF6C00",   
			    "#C62828"                 
			)
			
			```
		lineageTag: e573c2cd-e76f-4f3e-9ff0-708371ff3d92

	measure 'CIR Color' = ```
			
			VAR _CIR = [cost_to_income_ratio]
			RETURN
			SWITCH (
			    TRUE(),
			    ISBLANK(_CIR), BLANK(),
			    _CIR < 0.40, "#2E7D32",   
			    _CIR < 0.50, "#F9A825",   
			    _CIR < 0.60, "#EF6C00",   
			    "#C62828"                 
			)
			
			```
		lineageTag: c6e3a98f-9b08-4220-8899-2d69ffc04aad

