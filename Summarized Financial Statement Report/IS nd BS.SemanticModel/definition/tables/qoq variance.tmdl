table 'qoq variance'
	lineageTag: 15aa1a02-99fd-4055-bf77-95dfa6b93cdd

	measure NextQuarterDiff = ```
			
			VAR CurrentVal = SUM('qoq variance'[Value])
			VAR NextVal = CALCULATE(
			    SUM('qoq variance'[Value]),
			    NEXTQUARTER('qoq variance'[Attribute])
			)
			RETURN
			IF(ISBLANK(NextVal), BLANK(), CurrentVal - NextVal)
			
			```
		lineageTag: 1cdc945d-b8dd-4e7e-8163-19263c847de8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'QoQ %' = ```
			
			VAR qoq_curr = [NextQuarterDiff]
			VAR next_val = CALCULATE(
			    SUM('qoq variance'[Value]),
			    NEXTQUARTER('qoq variance'[Attribute])
			)
			RETURN
			DIVIDE(qoq_curr, next_val)
			
			```
		lineageTag: e443d5af-be01-4b18-bb67-3fc7e682e0aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure fy_2023 = ```
			
			CALCULATE(SUM('qoq variance'[Value]),
			          FILTER('qoq variance',  YEAR('qoq variance'[Attribute]) = 2023))  
			
			```
		lineageTag: e6f1b713-67ae-49bb-98b0-0a0705412fd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure fy_2024 = ```
			
			CALCULATE(SUM('qoq variance'[Value]),
			          FILTER('qoq variance', YEAR('qoq variance'[Attribute]) = 2024))  
			
			```
		lineageTag: c6515502-b056-4b6a-b37e-3a8bfa9aeb3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure q1_2025 =
			
			CALCULATE(SUM('qoq variance'[Value]),
			          MONTH('qoq variance'[Attribute]) IN {1,2,3},
			          YEAR('qoq variance'[Attribute]) = 2025
			)
		lineageTag: 8439d98d-6949-4e53-85ff-f2d6277c1eb9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure q2_2025 =
			
			CALCULATE(SUM('qoq variance'[Value]),
			          MONTH('qoq variance'[Attribute]) IN {4,5,6},
			          YEAR('qoq variance'[Attribute]) = 2025
			)
		lineageTag: bf81db8c-205c-4a48-8508-0086e7bb36f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure q3_2025 =
			
			CALCULATE(SUM('qoq variance'[Value]),
			          MONTH('qoq variance'[Attribute]) IN {7,8,9},
			          YEAR('qoq variance'[Attribute]) = 2025
			)
		lineageTag: 3f364130-8670-4aa2-a1c1-15864932091f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure q4_2022 =
			
			CALCULATE(SUM('qoq variance'[Value]),
			          MONTH('qoq variance'[Attribute]) IN {10,11,12},
			          YEAR('qoq variance'[Attribute]) = 2022
			)
		lineageTag: 650f9ce0-ddc0-4650-8bb2-b56568cdcece

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY Diff (2023-2024)' =
			
			[fy_2024] - [fy_2023]
		lineageTag: d27377f6-1d37-4046-a03c-3932657f2d12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YOY %' = DIVIDE([YOY Diff (2023-2024)], [fy_2023], "N/A")
		lineageTag: f884d70f-4b2c-41c3-9f0d-3a06c35440c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

