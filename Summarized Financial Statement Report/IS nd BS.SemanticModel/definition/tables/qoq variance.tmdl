	column bs_quarter_sort = ```
			
			YEAR('qoq variance'[Attribute] * 10 + 
			SWITCH(
			    TRUE(),
			    MONTH('qoq variance'[Attribute]) IN {1,2,3}, 1,
			    MONTH('qoq variance'[Attribute]) IN {4,5,6}, 2,
			    MONTH('qoq variance'[Attribute]) IN {7,8,9}, 3,
			    MONTH('qoq variance'[Attribute]) IN {10,11,12}, 4
			))
			
			```
		formatString: 0
		lineageTag: a5ab2958-df6c-4498-b717-f6e8b77ed7ea
